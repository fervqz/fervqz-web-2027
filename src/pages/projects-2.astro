---
import { Image } from "astro:assets";
import DotsBackground from "../components/DotsBackground.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Card from "../components/ui/Card.astro";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import Section from "../components/ui/Section.astro";
import Text from "../components/ui/Text.astro";
import { SITE_TITLE } from "../consts";
import { projectSections } from "../lib/projects";
import AppLayout from "../layouts/AppLayout.astro";

const allProjects = projectSections.flatMap((section) => section.projects);
---

<AppLayout
  title={`Projects Alt 2 | ${SITE_TITLE}`}
  description="Alternative projects layout with editorial cards and visual highlights."
  bodyClass="flex min-h-screen flex-col px-4"
>
  <DotsBackground />
  <Header />

  <main class="flex-1">
    <Container class="flex flex-col gap-12 py-12">
      <Section class="space-y-5">
        <Text as="p" tone="muted" class="text-sm uppercase tracking-[0.2em]">
          Projects · Alternative 02
        </Text>
        <Heading as="h1" variant="hero">Editorial showcase layout</Heading>
        <Text class="max-w-3xl">
          A visual-first alternative: section hero panels, bento-style project
          cards, and direct links to each project detail page.
        </Text>
      </Section>

      <Section class="grid gap-4 md:grid-cols-3">
        <Card class="space-y-2 border-slate-200/80 bg-white/85 md:col-span-2">
          <Text as="p" tone="muted" class="text-xs uppercase tracking-wider">
            Total projects
          </Text>
          <Heading as="h2">{allProjects.length}</Heading>
          <Text tone="soft" class="text-sm">
            Distributed across {projectSections.length} sections
          </Text>
        </Card>

        <Card class="space-y-2 border-slate-200/80 bg-white/85">
          <Text as="p" tone="muted" class="text-xs uppercase tracking-wider">
            Browse more
          </Text>
          <a
            href="/projects"
            class="w-fit text-sm font-semibold text-(--link-color) underline underline-offset-2 hover:text-(--link-hover-color)"
          >
            Open default projects page
          </a>
          <a
            href="/projects-3"
            class="w-fit text-sm font-semibold text-(--link-color) underline underline-offset-2 hover:text-(--link-hover-color)"
          >
            Open alternative 03
          </a>
        </Card>
      </Section>
    </Container>

    {
      projectSections.map((section) => (
        <section class="py-6">
          <Container class="space-y-6">
            <Card class="relative overflow-hidden border-slate-200/70 bg-slate-950 text-slate-100 shadow-xl">
              <div class="absolute inset-0 bg-linear-to-r from-indigo-500/20 via-fuchsia-500/10 to-cyan-400/10" />
              <div class="relative grid gap-6 p-6 md:grid-cols-[1.2fr_0.8fr] md:p-8">
                <div class="space-y-3">
                  <Text
                    as="p"
                    class="text-xs uppercase tracking-[0.2em] text-slate-300"
                  >
                    Section
                  </Text>
                  <Heading as="h2" variant="section" class="text-white">
                    {section.title}
                  </Heading>
                  <Text class="max-w-2xl text-slate-200">
                    {section.subtitle}
                  </Text>
                </div>
                <Image
                  src={section.image}
                  alt={section.imageAlt}
                  width={1400}
                  class="h-44 w-full rounded-xl border border-white/15 object-cover object-center"
                />
              </div>
            </Card>

            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {section.projects.map((project, index) => (
                <Card
                  class:list={[
                    "space-y-3 border-slate-200/80 bg-white/90 shadow-sm",
                    index === 0 && "md:col-span-2 xl:col-span-2",
                  ]}
                >
                  <Image
                    src={project.image}
                    alt={project.imageAlt}
                    width={1200}
                    class:list={[
                      "w-full border border-slate-200/70 object-cover",
                      index === 0 ? "h-56" : "h-40",
                    ]}
                  />

                  <div class="space-y-2">
                    <Text
                      as="p"
                      tone="muted"
                      class="text-xs uppercase tracking-wider"
                    >
                      {project.stage}
                    </Text>
                    <Heading as="h3">{project.name}</Heading>
                    <Text tone="soft" class="text-sm">
                      {project.summary}
                    </Text>
                  </div>

                  <Text
                    as="ul"
                    tone="soft"
                    class="list-disc space-y-1 pl-5 text-sm"
                  >
                    {project.highlights.slice(0, 2).map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </Text>

                  <div class="flex flex-wrap gap-2">
                    <a
                      href={`/projects/${project.slug}`}
                      class="inline-flex items-center justify-center border border-(--button-border) bg-(--button-bg) px-3 py-2 text-xs font-semibold text-(--button-text) no-underline transition-colors hover:bg-(--button-hover-bg) hover:text-(--button-hover-text)"
                    >
                      More details
                    </a>
                    {project.actions.slice(0, 1).map((action) => (
                      <a
                        href={action.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center border border-(--button-border) bg-(--button-bg) px-3 py-2 text-xs font-semibold text-(--button-text) no-underline transition-colors hover:bg-(--button-hover-bg) hover:text-(--button-hover-text)"
                      >
                        {action.label}
                      </a>
                    ))}
                  </div>
                </Card>
              ))}
            </div>
          </Container>
        </section>
      ))
    }
  </main>

  <Footer />
</AppLayout>
