---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { BLOG_ENABLED } from "../../consts";
import BlogPost from "../../layouts/BlogPost.astro";

const WORDS_PER_MINUTE = 200;

const getReadingTimeMinutes = (content: string) => {
  const plainText = content
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]*`/g, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[[^\]]*\]\([^)]*\)/g, "$1")
    .replace(/[>#*_~-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  const wordCount = plainText ? plainText.split(/\s+/).length : 0;
  return Math.max(1, Math.ceil(wordCount / WORDS_PER_MINUTE));
};

export async function getStaticPaths() {
  if (!BLOG_ENABLED) return [];

  const posts = await getCollection("blog", ({ data }) => !data.hidden);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
const readingTimeMinutes = getReadingTimeMinutes(post.body ?? "");
---

<BlogPost {...post.data} slug={post.id} readingTimeMinutes={readingTimeMinutes}>
  <Content />
</BlogPost>
