---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import DotsBackground from "../../components/DotsBackground.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
import AppLayout from "../../layouts/AppLayout.astro";
import BlogPostsSection from "../../sections/BlogPostsSection.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<AppLayout
  title={`Blog | ${SITE_TITLE}`}
  description="Articles, engineering notes, and development experiments from Fervqz."
  bodyClass="min-h-screen px-4"
>
  <DotsBackground />
  <main class="flex min-h-screen flex-col gap-12">
    <Header />
    <BlogPostsSection posts={posts} />
    <Footer />
  </main>
</AppLayout>
