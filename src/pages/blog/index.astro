---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import DotsBackground from "../../components/DotsBackground.astro";
import Header from "../../components/Header.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Heading from "../../components/ui/Heading.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="min-h-screen">
    <DotsBackground />
    <Header />
    <main class="pb-20 pt-12">
      <Container>
        <Section
          id="blog-list"
          class="mx-auto flex w-full max-w-190 flex-col gap-6"
        >
          {
            posts.map((post) => (
              <article class="blog-list-item group">
                <a
                  href={`/blog/${post.id}/`}
                  class="grid grid-cols-1 items-start gap-4 no-underline sm:grid-cols-[170px_1fr]"
                >
                  {post.data.heroImage && (
                    <Image
                      width={340}
                      height={220}
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="h-30 w-full object-cover sm:w-42.5"
                      style={`view-transition-name: blog-image-${post.id};`}
                    />
                  )}
                  <div class="space-y-2">
                    <Heading
                      as="h3"
                      class="mb-0 transition-colors group-hover:text-indigo-700"
                    >
                      {post.data.title}
                    </Heading>
                    <p class="mb-0 text-[14px] leading-5 text-slate-700">
                      {post.data.description} — quick notes, context, tech
                      stack, and progress updates from ongoing work.
                    </p>
                  </div>
                </a>
              </article>
            ))
          }
        </Section>
      </Container>
    </main>
    <Footer />

    <script>
      import { gsap } from "gsap";

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const items = document.querySelectorAll(".blog-list-item");
      const navigationEntry = performance.getEntriesByType("navigation")[0] as
        | PerformanceNavigationTiming
        | undefined;

      let cameFromBlogEntry = false;

      if (document.referrer) {
        const referrerUrl = new URL(document.referrer);
        cameFromBlogEntry =
          referrerUrl.origin === window.location.origin &&
          /^\/blog\/.+/.test(referrerUrl.pathname) &&
          referrerUrl.pathname !== "/blog/";
      }

      const isHistoryNavigation = navigationEntry?.type === "back_forward";
      const shouldAnimate =
        !prefersReducedMotion && !cameFromBlogEntry && !isHistoryNavigation;

      if (items.length > 0) {
        if (!shouldAnimate) {
          gsap.set(items, { opacity: 1, y: 0 });
        } else {
          gsap.fromTo(
            items,
            { opacity: 0, y: 18 },
            {
              opacity: 1,
              y: 0,
              duration: 0.7,
              stagger: 0.12,
              ease: "power2.out",
              clearProps: "opacity,transform",
            },
          );
        }
      }
    </script>
  </body>
</html>
