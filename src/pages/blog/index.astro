---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import DotsBackground from "../../components/DotsBackground.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="min-h-screen">
    <DotsBackground />
    <Header />
    <main class="pb-20 pt-12">
      <Container>
        <section class="mx-auto flex w-full max-w-190 flex-col gap-6">
          {
            posts.map((post) => (
              <article class="group">
                <a
                  href={`/blog/${post.id}/`}
                  class="grid grid-cols-1 items-start gap-4 no-underline sm:grid-cols-[170px_1fr]"
                >
                  {post.data.heroImage && (
                    <Image
                      width={340}
                      height={220}
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="h-30 w-full rounded-md object-cover sm:w-42.5"
                    />
                  )}
                  <div class="space-y-2">
                    <h3 class="mb-0 transition-colors group-hover:text-indigo-700">
                      {post.data.title}
                    </h3>
                    <p class="mb-0 text-[14px] leading-5 text-slate-700">
                      {post.data.description} — quick notes, context, tech
                      stack, and progress updates from ongoing work.
                    </p>
                  </div>
                </a>
              </article>
            ))
          }
        </section>
      </Container>
    </main>
    <Footer />
  </body>
</html>
