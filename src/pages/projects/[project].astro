---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DotsBackground from "../../components/DotsBackground.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
import {
  hardwareProjects,
  softwareProjects,
  type Project,
} from "../../lib/projects";
import AppLayout from "../../layouts/AppLayout.astro";
import ProjectDetailSection from "../../sections/ProjectDetailSection.astro";

export async function getStaticPaths() {
  const projects = [...softwareProjects, ...hardwareProjects];
  const contentEntries = await getCollection("projects-content");
  const toContentSlug = (id: string) =>
    id
      .replace(/\.(md|mdx)$/i, "")
      .split("/")
      .pop() ?? id;

  const contentBySlug = new Map(
    contentEntries.map((entry) => [toContentSlug(entry.id), entry]),
  );

  return projects.map((project) => {
    const content = contentBySlug.get(project.slug);

    if (!content) {
      throw new Error(
        `Missing MDX content for project \"${project.slug}\" in src/content/projects-content/`,
      );
    }

    return {
      params: { project: project.slug },
      props: {
        project,
        content,
      },
    };
  });
}

type Props = {
  project: Project;
  content: CollectionEntry<"projects-content">;
};

const { project, content } = Astro.props as Props;
const { Content } = await render(content);
---

<AppLayout
  title={`${project.name} | Projects | ${SITE_TITLE}`}
  description={project.summary}
  image={project.image}
  bodyClass="flex min-h-screen flex-col px-4"
>
  <DotsBackground />
  <main class="flex min-h-screen flex-col gap-12">
    <Header />
    <ProjectDetailSection project={project}>
      <Content />
    </ProjectDetailSection>
    <Footer />
  </main>
</AppLayout>
