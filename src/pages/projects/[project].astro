---
import DotsBackground from "../../components/DotsBackground.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
import {
  hardwareProjects,
  softwareProjects,
  type Project,
} from "../../lib/projects";
import AppLayout from "../../layouts/AppLayout.astro";
import ProjectDetailSection from "../../sections/ProjectDetailSection.astro";

export async function getStaticPaths() {
  return [
    ...softwareProjects.map((project) => ({
      params: { project: project.slug },
      props: {
        project,
      },
    })),
    ...hardwareProjects.map((project) => ({
      params: { project: project.slug },
      props: {
        project,
      },
    })),
  ];
}

type Props = {
  project: Project;
};

const { project } = Astro.props as Props;
---

<AppLayout
  title={`${project.name} | Projects | ${SITE_TITLE}`}
  description={project.summary}
  image={project.image}
  bodyClass="flex min-h-screen flex-col px-4"
>
  <DotsBackground />
  <main class="flex min-h-screen flex-col gap-12">
    <Header />
    <ProjectDetailSection project={project} />
    <Footer />
  </main>
</AppLayout>
