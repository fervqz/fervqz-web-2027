---
import DotsBackground from "../../components/DotsBackground.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
import {
  hardwareProjects,
  softwareProjects,
  type Project,
} from "../../lib/projects";
import AppLayout from "../../layouts/AppLayout.astro";
import ProjectDetailSection from "../../sections/ProjectDetailSection.astro";

type ProjectCollection = "software" | "hardware";

export async function getStaticPaths() {
  return [
    ...softwareProjects.map((project) => ({
      params: { project: project.slug },
      props: {
        project,
        collection: "software" as const,
      },
    })),
    ...hardwareProjects.map((project) => ({
      params: { project: project.slug },
      props: {
        project,
        collection: "hardware" as const,
      },
    })),
  ];
}

type Props = {
  project: Project;
  collection: ProjectCollection;
};

const { project, collection } = Astro.props as Props;

const projectCollection =
  collection === "software" ? softwareProjects : hardwareProjects;

const relatedProjects = projectCollection
  .filter((item) => item.slug !== project.slug)
  .slice(0, 3);
---

<AppLayout
  title={`${project.name} | Projects | ${SITE_TITLE}`}
  description={project.summary}
  image={project.image}
  bodyClass="flex min-h-screen flex-col px-4"
>
  <DotsBackground />
  <main class="flex min-h-screen flex-col gap-12">
    <Header />
    <ProjectDetailSection project={project} relatedProjects={relatedProjects} />
    <Footer />
  </main>
</AppLayout>
