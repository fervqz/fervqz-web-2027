---
import { SITE_TITLE } from "../consts";
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout
  title={`Redirecting | ${SITE_TITLE}`}
  description="Redirecting to the home page."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content="0;url=/" />
    <link rel="canonical" href={new URL("/", Astro.site)} />
  </Fragment>

  <script>
    window.location.replace("/");
  </script>

  <main class="flex min-h-screen items-center justify-center px-4 text-center">
    <p>
      Redirecting to the home page. If nothing happens, <a href="/">go home</a>.
    </p>
  </main>
</AppLayout>
