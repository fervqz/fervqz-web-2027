---
import DotsBackground from "../components/DotsBackground.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
import AppLayout from "../layouts/AppLayout.astro";
import ProjectsSoftwareSection from "../sections/ProjectsSoftwareSection.astro";
import ProjectsHardwareSection from "../sections/ProjectsHardwareSection.astro";
import ProjectsFailsSection from "../sections/ProjectsFailsSection.astro";
---

<AppLayout
  title={`Projects | ${SITE_TITLE}`}
  description="Selected projects by Fervqz including product work, frontend experiments, and shipped web experiences."
  bodyClass="flex min-h-screen flex-col px-4"
>
  <DotsBackground />
  <main class="flex flex-col gap-12">
    <Header />
    <ProjectsSoftwareSection />
    <ProjectsHardwareSection />
    <ProjectsFailsSection />
    <Footer />
  </main>
</AppLayout>
