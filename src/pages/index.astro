---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import AppLayout from "../layouts/AppLayout.astro";
import DotsBackground from "../components/DotsBackground.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ExperienceTimelineSection from "../sections/ExperienceTimelineSection.astro";
import HeroSection from "../sections/HeroSection.astro";
import LatestBlogMarqueeSection from "../sections/LatestBlogMarqueeSection.astro";
import ProjectsShowcaseSection from "../sections/ProjectsShowcaseSection.astro";
import { experience } from "../lib/experience";

const latestPosts = (await getCollection("blog", ({ data }) => !data.hidden))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);
---

<AppLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  bodyClass="flex flex-col min-h-screen px-4"
>
  <DotsBackground />
  <main class="flex flex-col gap-24">
    <Header />
    <HeroSection />
    <ProjectsShowcaseSection />
    <LatestBlogMarqueeSection posts={latestPosts} />
    <ExperienceTimelineSection experience={experience} />
    <Footer />
  </main>
</AppLayout>
