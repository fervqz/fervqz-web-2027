---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import AppLayout from "../layouts/AppLayout.astro";
import DotsBackground from "../components/DotsBackground.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ExperienceTimelineSection from "../sections/ExperienceTimelineSection.astro";
import HeroSection from "../sections/HeroSection.astro";
import { experience } from "../lib/experience";
---

<AppLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  bodyClass="flex flex-col min-h-screen px-4"
>
  <DotsBackground />
  <main class="flex flex-col gap-18">
    <Header />
    <HeroSection />
    <ExperienceTimelineSection experience={experience} />
    <Footer />
  </main>
</AppLayout>
