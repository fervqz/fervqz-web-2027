---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import DotsBackground from "../components/DotsBackground.astro";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import Section from "../components/ui/Section.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="flex flex-col min-h-screen">
    <DotsBackground />
    <Header />
    <main class="flex-1 justify-center items-center flex">
      <Container class="flex-1 py-12 flex flex-col gap-14">
        <Section variant="content" class="flex flex-row gap-12 items-center">
          <img
            src="/public/img/avatar.svg"
            alt="logo"
            width="280"
            class="drop-shadow-sm drop-shadow-zinc-900/30 hover:scale-105 hover:-rotate-2 transition-transform ease-out hover:drop-shadow-xl hover:drop-shadow-zinc-900/20"
          />
          <div>
            <p class="text-sm uppercase tracking-[0.2em] text-slate-500">
              Meet Your Next
            </p>
            <h1 class="mt-3.5 mb-6 text-6xl leading-tight font-black">
              <span class="rotating-word-stack" aria-live="polite">
                <span class="rotating-word">Creative</span>
                <span class="rotating-word">Product</span>
                <span class="rotating-word">Frontend</span>
              </span>
              <br />
              Developer
            </h1>
            <p class="max-w-3xl text-slate-700">
              When I sarted coding, I was drawn to the web for its unique blend
              of creativity and logic. Over the years, I've honed my skills as a
              creative developer, with a particular focus on crafting engaging
              user experiences.
            </p>
          </div>
        </Section>
      </Container>
    </main>
    <Footer />

    <script>
      import { gsap } from "gsap";

      const stack = document.querySelector(".rotating-word-stack");

      if (stack instanceof HTMLElement) {
        const words = Array.from(
          stack.querySelectorAll<HTMLElement>(".rotating-word"),
        );

        if (words.length > 0) {
          const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;

          const maxWidth = Math.max(...words.map((word) => word.offsetWidth));
          stack.style.width = `${maxWidth}px`;

          gsap.set(words, { yPercent: 100, autoAlpha: 1 });
          gsap.set(words[0], { yPercent: 0 });

          if (!reduceMotion && words.length > 1) {
            let index = 0;
            const stepDuration = 0.55;
            const holdDuration = 1.1;

            const rotatePush = () => {
              const current = words[index];
              const nextIndex = (index + 1) % words.length;
              const next = words[nextIndex];

              const tl = gsap.timeline({
                onComplete: () => {
                  gsap.set(current, { yPercent: 100 });
                  index = nextIndex;
                  gsap.delayedCall(holdDuration, rotatePush);
                },
              });

              tl.to(
                current,
                {
                  yPercent: -100,
                  duration: stepDuration,
                  ease: "power2.inOut",
                },
                0,
              ).fromTo(
                next,
                { yPercent: 100 },
                {
                  yPercent: 0,
                  duration: stepDuration,
                  ease: "power2.inOut",
                },
                0,
              );
            };

            gsap.delayedCall(holdDuration, rotatePush);
          } else {
            gsap.set(words.slice(1), { yPercent: 100 });
          }
        }
      }
    </script>
  </body>
</html>

<style>
  .rotating-word-stack {
    position: relative;
    display: inline-block;
    height: 1.1em;
    overflow: hidden;
    vertical-align: baseline;
  }

  .rotating-word {
    position: absolute;
    inset: 0 auto auto 0;
    white-space: nowrap;
    will-change: transform, opacity;
  }
</style>
