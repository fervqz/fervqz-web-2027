---
import type { ExperienceEntry } from "../lib/experience";
import Card from "../components/ui/Card.astro";
import Container from "../components/ui/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Sticker from "../components/sticker/Sticker.astro";
import Badge from "../components/ui/Badge.astro";
import Text from "../components/ui/Text.astro";

interface Props {
  experience: ExperienceEntry[];
}

const { experience: rawExperience } = Astro.props;
const experience = rawExperience.filter((entry) => entry.show);
---

<Container class="py-10">
  <div class="mb-10">
    <SectionHeader eyebrow="03 — Experience" title="Experience journey" />
  </div>
  <div class="relative">
    <div
      class="absolute bottom-0 left-3 top-0 w-px -translate-x-1/2 bg-slate-200 md:left-56"
    >
    </div>
    <ol class="flex flex-col gap-12">
      {
        experience.map((entry, i) => (
          <li
            class="experience-timeline-item relative pl-12 md:grid md:grid-cols-[11rem_4rem_minmax(0,1fr)] md:items-center md:gap-x-4 md:pl-0"
            style={`--timeline-delay: ${i * 120}ms;`}
            data-timeline-item
          >
            <div class="experience-timeline-sticker absolute -right-2 -bottom-6 z-10 flex size-32 items-center justify-center md:static md:col-start-1 md:row-start-1 md:z-5 md:size-44 md:self-center md:justify-self-center">
              <Sticker
                src={entry.icon}
                alt=""
                width={entry.iconSize}
                loading="lazy"
              />
            </div>

            <div class="experience-timeline-dot-wrap absolute left-0 top-1.5 flex w-6 items-start justify-center md:static md:col-start-2 md:row-start-1 md:w-16 md:items-center md:justify-center">
              <span class="experience-timeline-dot flex h-7 w-7 shrink-0 aspect-square items-center justify-center rounded-full border border-slate-200 bg-(--bg-color)">
                <span class="h-2.5 w-2.5 rounded-full bg-(--accent)" />
              </span>
            </div>

            <div class="experience-timeline-card-wrap relative md:col-start-3 md:row-start-1">
              <Card class="experience-timeline-card space-y-3">
                <div>
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-widest text-(--accent)">
                    {entry.period}
                  </span>
                  <h3 class="mb-0 text-[1.375rem] leading-[1.2727] tracking-[-0.26px]">
                    {entry.role}
                  </h3>
                  <Text tone="soft" class="text-sm">
                    {entry.company}
                  </Text>
                </div>
                <ul class="flex flex-wrap gap-2">
                  {entry.stack.map((item) => (
                    <Badge as="li">{item}</Badge>
                  ))}
                </ul>
              </Card>
            </div>

          </li>
        ))
      }
    </ol>
  </div>
</Container>

<script>
  const timelineItems = Array.from(
    document.querySelectorAll("[data-timeline-item]"),
  );

  const revealTimelineItem = (item: Element) => {
    item.setAttribute("data-in-view", "true");
  };

  if (
    typeof window !== "undefined" &&
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          revealTimelineItem(entry.target);
          currentObserver.unobserve(entry.target);
        });
      },
      {
        threshold: 0.2,
        rootMargin: "0px 0px -10% 0px",
      },
    );

    timelineItems.forEach((item) => observer.observe(item));
  } else {
    timelineItems.forEach(revealTimelineItem);
  }
</script>

<style>
  .experience-timeline-item {
    opacity: 0;
  }

  .experience-timeline-card,
  .experience-timeline-dot,
  .experience-timeline-sticker {
    transition:
      opacity 560ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--timeline-delay, 0ms);
    will-change: opacity, transform;
  }

  .experience-timeline-card {
    opacity: 0;
    transform: translateY(24px);
  }

  .experience-timeline-sticker {
    opacity: 0;
    transform: translate(14%, 30%) rotate(10deg);
  }

  .experience-timeline-dot {
    opacity: 0;
    transform: scale(0.72);
  }

  @media (min-width: 48rem) {
    .experience-timeline-card {
      transform: translateX(28px);
    }

    .experience-timeline-sticker {
      transform: translateX(20px) rotate(10deg);
    }

    .experience-timeline-item:nth-child(odd) .experience-timeline-sticker {
      transform: translateX(20px) rotate(-10deg);
    }
  }

  .experience-timeline-item[data-in-view="true"] {
    opacity: 1;
  }

  .experience-timeline-item[data-in-view="true"] .experience-timeline-card,
  .experience-timeline-item[data-in-view="true"] .experience-timeline-dot {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .experience-timeline-item[data-in-view="true"] .experience-timeline-sticker {
    opacity: 1;
    transform: translate(8%, 24%) rotate(10deg);
  }

  @media (min-width: 48rem) {
    .experience-timeline-item[data-in-view="true"] .experience-timeline-sticker {
      transform: rotate(10deg);
    }

    .experience-timeline-item[data-in-view="true"]:nth-child(odd)
      .experience-timeline-sticker {
      transform: rotate(-10deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-timeline-item,
    .experience-timeline-card,
    .experience-timeline-dot,
    .experience-timeline-sticker {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .experience-timeline-sticker {
      transform: translate(8%, 24%) rotate(10deg);
    }

    @media (min-width: 48rem) {
      .experience-timeline-sticker {
        transform: rotate(10deg);
      }

      .experience-timeline-item:nth-child(odd) .experience-timeline-sticker {
        transform: rotate(-10deg);
      }
    }
  }
</style>
