---
import type { ExperienceEntry } from "../lib/experience";
import Card from "../components/ui/Card.astro";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import Sticker from "../components/sticker/Sticker.astro";
import Text from "../components/ui/Text.astro";

interface Props {
  experience: ExperienceEntry[];
}

const { experience: rawExperience } = Astro.props;
const experience = rawExperience.filter((entry) => entry.show);
---

<Container class="py-10">
  <div class="mb-10">
    <Heading as="h1" variant="section" class="text-center"
      >🚀 Experience Journey</Heading
    >
  </div>
  <div class="relative">
    <div
      class="absolute bottom-0 left-3 top-0 w-px bg-slate-200 md:left-1/2 md:-translate-x-1/2"
    >
    </div>
    <ol class="flex flex-col gap-12">
      {
        experience.map((entry, i) => (
          <li
            class="experience-timeline-item relative pl-12 md:grid md:grid-cols-[minmax(0,1fr)_4rem_minmax(0,1fr)] md:items-start md:pl-0 md:[&:nth-child(odd)_.experience-timeline-card-wrap]:col-1 md:[&:nth-child(even)_.experience-timeline-card-wrap]:col-3 md:[&:nth-child(odd)_.experience-timeline-label-wrap]:col-3 md:[&:nth-child(odd)_.experience-timeline-label-wrap]:justify-start md:[&:nth-child(even)_.experience-timeline-label-wrap]:col-1 md:[&:nth-child(even)_.experience-timeline-label-wrap]:justify-end md:[&:nth-child(even)_.experience-timeline-label-wrap]:text-right md:[&:nth-child(odd)_.experience-timeline-sticker]:right-[calc(100%+1rem)] md:[&:nth-child(even)_.experience-timeline-sticker]:left-[calc(100%+1rem)]"
            style={`--timeline-delay: ${i * 120}ms;`}
            data-timeline-item
          >
            <div class="experience-timeline-dot-wrap absolute left-0 top-1.5 flex w-6 items-start justify-center md:static md:col-start-2 md:row-start-1 md:w-16 md:justify-center md:pt-5">
              <span class="experience-timeline-dot flex h-7 w-7 shrink-0 aspect-square items-center justify-center rounded-full border border-slate-200 bg-(--bg-color)">
                <span class="h-2.5 w-2.5 rounded-full bg-slate-400" />
              </span>
            </div>

            <div class="experience-timeline-label experience-timeline-label-wrap mb-3 flex items-start md:row-start-1 md:mb-0 md:pt-6">
              <span class="text-xs font-semibold uppercase tracking-widest text-(--soft-text-color)">
                {entry.period}
              </span>
            </div>

            <div class="experience-timeline-card-wrap relative md:row-start-1">
              <div class="experience-timeline-sticker absolute right-0 bottom-0 z-10 flex size-32 items-center justify-center md:top-1/2 md:right-auto md:bottom-auto md:z-5 md:size-44">
                <Sticker
                  src={entry.icon as unknown as ImageMetadata}
                  alt=""
                  width={entry.iconSize}
                  loading="lazy"
                />
              </div>

              <Card class="experience-timeline-card space-y-3">
                <div>
                  <Heading as="h3" class="mb-0!">
                    {entry.role}
                  </Heading>
                  <Text tone="soft" class="text-sm">
                    {entry.company}
                  </Text>
                </div>
              </Card>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Container>

<script>
  const timelineItems = Array.from(
    document.querySelectorAll("[data-timeline-item]"),
  );

  const revealTimelineItem = (item: Element) => {
    item.setAttribute("data-in-view", "true");
  };

  if (
    typeof window !== "undefined" &&
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          revealTimelineItem(entry.target);
          currentObserver.unobserve(entry.target);
        });
      },
      {
        threshold: 0.2,
        rootMargin: "0px 0px -10% 0px",
      },
    );

    timelineItems.forEach((item) => observer.observe(item));
  } else {
    timelineItems.forEach(revealTimelineItem);
  }
</script>

<style>
  .experience-timeline-item {
    opacity: 0;
  }

  .experience-timeline-card,
  .experience-timeline-dot,
  .experience-timeline-label,
  .experience-timeline-sticker {
    transition:
      opacity 560ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--timeline-delay, 0ms);
    will-change: opacity, transform;
  }

  .experience-timeline-card {
    opacity: 0;
    transform: translateY(24px);
  }

  .experience-timeline-sticker {
    opacity: 0;
    transform: translate(14%, 30%) rotate(-10deg);
  }

  .experience-timeline-dot {
    opacity: 0;
    transform: scale(0.72);
  }

  .experience-timeline-label {
    opacity: 0;
    transform: translateY(10px);
  }

  @media (min-width: 48rem) {
    .experience-timeline-sticker {
      transform: translateY(-50%) rotate(-10deg);
    }

    .experience-timeline-item:nth-child(odd) .experience-timeline-sticker {
      transform: translateY(-50%) rotate(10deg);
    }

    .experience-timeline-item:nth-child(odd) .experience-timeline-card,
    .experience-timeline-item:nth-child(odd) .experience-timeline-label {
      transform: translateX(-28px);
    }

    .experience-timeline-item:nth-child(even) .experience-timeline-card,
    .experience-timeline-item:nth-child(even) .experience-timeline-label {
      transform: translateX(28px);
    }
  }

  .experience-timeline-item[data-in-view="true"] {
    opacity: 1;
  }

  .experience-timeline-item[data-in-view="true"] .experience-timeline-card,
  .experience-timeline-item[data-in-view="true"] .experience-timeline-dot,
  .experience-timeline-item[data-in-view="true"] .experience-timeline-label {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .experience-timeline-item[data-in-view="true"] .experience-timeline-sticker {
    opacity: 1;
    transform: translate(8%, 24%) rotate(-10deg);
  }

  @media (min-width: 48rem) {
    .experience-timeline-item[data-in-view="true"]:nth-child(odd)
      .experience-timeline-sticker {
      opacity: 1;
      transform: translate(0, -50%) rotate(-10deg);
    }

    .experience-timeline-item[data-in-view="true"]:nth-child(even)
      .experience-timeline-sticker {
      opacity: 1;
      transform: translate(0, -50%) rotate(10deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-timeline-item,
    .experience-timeline-card,
    .experience-timeline-dot,
    .experience-timeline-label,
    .experience-timeline-sticker {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .experience-timeline-sticker {
      transform: translate(8%, 24%) rotate(-10deg);
    }

    @media (min-width: 48rem) {
      .experience-timeline-item:nth-child(odd) .experience-timeline-sticker {
        transform: translate(0, -50%) rotate(-10deg);
      }

      .experience-timeline-item:nth-child(even) .experience-timeline-sticker {
        transform: translate(0, -50%) rotate(10deg);
      }
    }
  }
</style>
