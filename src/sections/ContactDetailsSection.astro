---
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Container from "../components/ui/Container.astro";
import FormLabel from "../components/ui/FormLabel.astro";
import Heading from "../components/ui/Heading.astro";
import Section from "../components/ui/Section.astro";
import Text from "../components/ui/Text.astro";
import TextArea from "../components/ui/TextArea.astro";
import TextInput from "../components/ui/TextInput.astro";
---

<Container class="pb-12">
  <Section class="flex justify-center">
    <Card
      class="relative max-w-[50%] space-y-4 bg-(--surface-color) backdrop-blur pb-14 [clip-path:polygon(0_0,100%_0,100%_100%,95%_calc(100%-14px),90%_100%,85%_calc(100%-14px),80%_100%,75%_calc(100%-14px),70%_100%,65%_calc(100%-14px),60%_100%,55%_calc(100%-14px),50%_100%,45%_calc(100%-14px),40%_100%,35%_calc(100%-14px),30%_100%,25%_calc(100%-14px),20%_100%,15%_calc(100%-14px),10%_100%,5%_calc(100%-14px),0_100%)] shadow-lg"
    >
      <Heading as="h2" variant="section">Send a message</Heading>
      <!-- TODO: Replace with real form intro copy and wire up form backend -->
      <Text>
        Placeholder form for layout testing. Hook it up to your preferred form
        backend or email workflow later.
      </Text>
      <div class="space-y-3">
        <FormLabel for="contact-name">Name</FormLabel>
        <TextInput id="contact-name" type="text" placeholder="Your name" />
      </div>
      <div class="space-y-3">
        <FormLabel for="contact-email">Email</FormLabel>
        <!-- TODO: Replace placeholder with real hint if needed -->
        <TextInput
          id="contact-email"
          type="email"
          placeholder="you@example.com"
        />
      </div>
      <div class="space-y-3">
        <FormLabel for="contact-message">Project details</FormLabel>
        <TextArea
          id="contact-message"
          rows="6"
          placeholder="Tell me a bit about your idea, timeline, or team..."
        />
      </div>
      <Button type="button" class="hover:cursor-pointer w-full"
        >Send inquiry</Button
      >
    </Card>
  </Section>
</Container>
