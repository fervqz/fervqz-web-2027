---
import { Image } from "astro:assets";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import MagneticButton from "../components/ui/MagneticButton.astro";
import Section from "../components/ui/Section.astro";
import { Icon } from "astro-icon/components";
import project1 from "../assets/img/project-1.png";
import project2 from "../assets/img/project-2.png";
import project3 from "../assets/img/project-3.png";

const images = [
  { src: project1, alt: "Project 1", delay: "0ms", rotation: "-8deg" },
  { src: project2, alt: "Project 2", delay: "120ms", rotation: "6deg" },
  { src: project3, alt: "Project 3", delay: "240ms", rotation: "-4deg" },
];
---

<Section variant="content" class="px-4 mx-auto max-w-7xl space-y-18">
  <Container>
    <Heading as="h1" variant="section" class="text-center"
      >💻 Explore My Projects</Heading
    >

    <div class="mt-10 flex justify-center">
      <MagneticButton
        href="/projects"
        class="px-6 py-3"
        style="--button-bg: var(--bg-color)"
      >
        Explore Projects Gallery
        <Icon name="lucide:arrow-up-right" class="ml-2 size-4" />
      </MagneticButton>
    </div>
  </Container>

  <div
    class="grid grid-cols-3 gap-6 max-md:mx-auto max-md:max-w-md max-md:grid-cols-1"
  >
    {
      images.map((img) => (
        <div
          class="overflow-hidden opacity-0 transform-[translateY(48px)_rotate(0deg)] transition-[opacity,transform] duration-600 ease-[cubic-bezier(0.22,1,0.36,1)] delay-(--item-delay) will-change-[opacity,transform] data-[in-view=true]:opacity-100 data-[in-view=true]:transform-[translateY(0)_rotate(var(--item-rotation))] motion-reduce:opacity-100 motion-reduce:transform-none motion-reduce:transition-none"
          style={`--item-delay: ${img.delay}; --item-rotation: ${img.rotation};`}
          data-projects-showcase-item
        >
          <Image
            src={img.src}
            alt={img.alt}
            width={600}
            loading="lazy"
            decoding="async"
            class="block h-auto w-full object-cover"
          />
        </div>
      ))
    }
  </div>
</Section>

<script>
  if (
    typeof window !== "undefined" &&
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute("data-in-view", "true");
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -60px 0px" },
    );

    document
      .querySelectorAll("[data-projects-showcase-item]")
      .forEach((el) => observer.observe(el));
  } else {
    document
      .querySelectorAll("[data-projects-showcase-item]")
      .forEach((el) => el.setAttribute("data-in-view", "true"));
  }
</script>
