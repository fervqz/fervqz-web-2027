---
import { Image } from "astro:assets";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import Section from "../components/ui/Section.astro";
import { Icon } from "astro-icon/components";
import project1 from "../assets/img/project-1.png";
import project2 from "../assets/img/project-2.png";
import project3 from "../assets/img/project-3.png";

const images = [
  { src: project1, alt: "Project 1", delay: "0ms", rotation: "-8deg" },
  { src: project2, alt: "Project 2", delay: "120ms", rotation: "6deg" },
  { src: project3, alt: "Project 3", delay: "240ms", rotation: "-4deg" },
];
---

<Section variant="content" class="px-4 mx-auto max-w-7xl space-y-18">
  <Container>
    <Heading as="h1" variant="section" class="text-center"
      >💻 Explore My Projects</Heading
    >

    <div class="mt-10 flex justify-center">
      <a
        href="/projects"
        class="inline-flex items-center justify-center border border-(--button-border) bg-(--button-bg) px-6 py-3 text-sm font-semibold text-(--button-text) transition-[color,background-color,transform] duration-250 ease-out will-change-transform hover:bg-(--button-hover-bg) hover:text-(--button-hover-text)"
        data-magnetic-button
      >
        Explore Projects Gallery
        <Icon name="lucide:arrow-up-right" class="ml-2 size-4" />
      </a>
    </div>
  </Container>

  <div
    class="grid grid-cols-3 gap-6 max-md:mx-auto max-md:max-w-md max-md:grid-cols-1"
  >
    {
      images.map((img) => (
        <div
          class="overflow-hidden opacity-0 transform-[translateY(48px)_rotate(0deg)] transition-[opacity,transform] duration-600 ease-[cubic-bezier(0.22,1,0.36,1)] delay-(--item-delay) will-change-[opacity,transform] data-[in-view=true]:opacity-100 data-[in-view=true]:transform-[translateY(0)_rotate(var(--item-rotation))] motion-reduce:opacity-100 motion-reduce:transform-none motion-reduce:transition-none"
          style={`--item-delay: ${img.delay}; --item-rotation: ${img.rotation};`}
          data-projects-showcase-item
        >
          <Image
            src={img.src}
            alt={img.alt}
            width={600}
            loading="lazy"
            decoding="async"
            class="block h-auto w-full object-cover"
          />
        </div>
      ))
    }
  </div>
</Section>

<script>
  const MAGNETIC_ACTIVATION_AREA = 200;
  const MAGNETIC_STRENGTH = 0.22;
  const MAGNETIC_MAX_OFFSET = 50;

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  const setupMagneticButtons = () => {
    if (typeof window === "undefined") return;
    if (!window.matchMedia("(pointer: fine)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    document
      .querySelectorAll<HTMLElement>("[data-magnetic-button]")
      .forEach((button) => {
        if (button.dataset.magneticInitialized === "true") return;
        button.dataset.magneticInitialized = "true";

        let pointerInsideActivationArea = false;

        const reset = () => {
          pointerInsideActivationArea = false;
          button.style.transform = "translate3d(0, 0, 0)";
        };

        const handlePointerMove = (event: PointerEvent) => {
          const rect = button.getBoundingClientRect();
          const expandedLeft = rect.left - MAGNETIC_ACTIVATION_AREA;
          const expandedRight = rect.right + MAGNETIC_ACTIVATION_AREA;
          const expandedTop = rect.top - MAGNETIC_ACTIVATION_AREA;
          const expandedBottom = rect.bottom + MAGNETIC_ACTIVATION_AREA;

          pointerInsideActivationArea =
            event.clientX >= expandedLeft &&
            event.clientX <= expandedRight &&
            event.clientY >= expandedTop &&
            event.clientY <= expandedBottom;

          if (!pointerInsideActivationArea) {
            button.style.transform = "translate3d(0, 0, 0)";
            return;
          }

          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;
          const offsetX = clamp(
            (event.clientX - centerX) * MAGNETIC_STRENGTH,
            -MAGNETIC_MAX_OFFSET,
            MAGNETIC_MAX_OFFSET,
          );
          const offsetY = clamp(
            (event.clientY - centerY) * MAGNETIC_STRENGTH,
            -MAGNETIC_MAX_OFFSET,
            MAGNETIC_MAX_OFFSET,
          );

          button.style.transform = `translate3d(${offsetX}px, ${offsetY}px, 0)`;
        };

        globalThis.addEventListener("pointermove", handlePointerMove, {
          passive: true,
        });
        button.addEventListener("pointerleave", reset);
        globalThis.addEventListener("blur", reset);
      });
  };

  setupMagneticButtons();

  if (
    typeof window !== "undefined" &&
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute("data-in-view", "true");
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -60px 0px" },
    );

    document
      .querySelectorAll("[data-projects-showcase-item]")
      .forEach((el) => observer.observe(el));
  } else {
    document
      .querySelectorAll("[data-projects-showcase-item]")
      .forEach((el) => el.setAttribute("data-in-view", "true"));
  }
</script>
