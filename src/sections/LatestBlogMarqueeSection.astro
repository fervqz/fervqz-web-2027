---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import Section from "../components/ui/Section.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
const marqueePosts = posts.slice(0, 6);
---

{
  marqueePosts.length > 0 && (
    <Section variant="content" class="px-4 mx-auto w-full max-w-7xl md:py-12">
      <Container>
        <Heading as="h2" variant="section" class="text-center">
          ✍️ Latest Blog Entries
        </Heading>
      </Container>

      <div
        class="group relative overflow-hidden mask-[linear-gradient(90deg,transparent,rgb(0_0_0/1)_10%,rgb(0_0_0/1)_90%,transparent)] motion-reduce:overflow-x-auto motion-reduce:mask-none"
        aria-label="Latest blog posts"
      >
        <div class="latest-blog-marquee-track flex w-max gap-5 py-4 animate-[latest-blog-marquee-scroll_30s_linear_infinite] group-hover:[animation-play-state:paused] motion-reduce:animate-none">
          {[...marqueePosts, ...marqueePosts].map((post, i) => (
            <a
              href={`/blog/${post.id}/`}
              class="latest-blog-marquee-item flex h-95 w-70 shrink-0 flex-col overflow-hidden border border-(--surface-border) bg-(--surface-color) no-underline transition-[border-color,transform] duration-180 ease-out hover:-translate-y-1 hover:border-(--link-hover-color)"
              aria-label={`Read ${post.data.title}`}
              data-duplicate={i >= marqueePosts.length ? "true" : undefined}
            >
              <div class="h-45 w-full overflow-hidden">
                {post.data.heroImage && (
                  <Image
                    src={post.data.heroImage}
                    alt=""
                    width={300}
                    height={300}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <div class="flex flex-1 flex-col gap-2 overflow-hidden p-4">
                <span class="text-[0.9rem] leading-[1.3] font-semibold text-(--text-color)">
                  {post.data.title}
                </span>
                <span class="overflow-hidden text-[0.8rem] leading-[1.4] text-(--soft-text-color) [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2]">
                  {post.data.description}
                </span>
                <span class="text-[0.7rem] tracking-[0.02em] uppercase text-(--soft-text-color)">
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                  })}
                </span>
                {post.data.tags && post.data.tags.length > 0 && (
                  <ul class="mt-auto m-0 flex list-none flex-wrap gap-[0.4rem] p-0">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <li class="rounded bg-(--surface-border) px-2 py-1 text-[0.65rem] whitespace-nowrap text-(--soft-text-color)">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </Section>
  )
}

<style>
  @keyframes latest-blog-marquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .latest-blog-marquee-item[data-duplicate="true"] {
      display: none;
    }
  }
</style>
