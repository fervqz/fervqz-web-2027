---
import type { Project } from "../lib/projects";
import ProjectHeader from "../components/projects/ProjectHeader.astro";
import ProjectRecommendations from "../components/projects/ProjectRecommendations.astro";
import BackLink from "../components/ui/BackLink.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Typography from "../components/ui/Typography.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<main class="relative flex-1 overflow-hidden">
  <Container class="relative z-10 flex flex-col gap-16">
    <Section class="space-y-6">
      <BackLink href="/projects" ariaLabel="Back to projects" />
      <ProjectHeader project={project} />
    </Section>

    <Section variant="content">
      <Typography>
        <slot />
      </Typography>
    </Section>

    <ProjectRecommendations currentProjectSlug={project.slug} />
  </Container>
</main>
