---
import type { Project } from "../lib/projects";
import ProjectHeader from "../components/projects/ProjectHeader.astro";
import ProjectRecommendations from "../components/projects/ProjectRecommendations.astro";
import BackLink from "../components/ui/BackLink.astro";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import Section from "../components/ui/Section.astro";
import Text from "../components/ui/Text.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<main class="relative flex-1 overflow-hidden">
  <Container class="relative z-10 flex flex-col gap-16">
    <Section class="space-y-6">
      <BackLink href="/projects" ariaLabel="Back to projects" />
      <ProjectHeader project={project} />
    </Section>

    <Section>
      <div class="space-y-4">
        <Heading as="h2" variant="section">Motivation</Heading>
        {project.details.map((paragraph) => <Text>{paragraph}</Text>)}
      </div>
    </Section>

    <Section>
      <div class="space-y-4">
        <Heading as="h2" variant="section">Highlights</Heading>
        <Text as="ul" tone="soft" class="list-disc space-y-2 pl-5 text-sm">
          {project.highlights.map((highlight) => <li>{highlight}</li>)}
        </Text>
      </div>
    </Section>

    <ProjectRecommendations currentProjectSlug={project.slug} />
  </Container>
</main>
