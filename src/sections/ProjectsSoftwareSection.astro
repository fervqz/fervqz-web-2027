---
import ProjectCarouselSection from "../components/projects/ProjectCarouselSection.astro";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";
import Section from "../components/ui/Section.astro";
import { softwareProjects } from "../lib/projects";
---

<Section variant="content">
  <Container>
    <div class="flex w-full flex-col gap-4 py-6">
      <Heading as="h2" variant="section">Mobile and Web Apps</Heading>
      <Text class="max-w-3xl" tone="soft">
        Software that I wanted to use but didn't exist yet, <span
          class="underline decoration-2 decoration-wavy underline-offset-8 decoration-(--nav-link-active-color)"
          >so I built it myself.</span
        >
      </Text>
    </div>
  </Container>
  <ProjectCarouselSection projects={softwareProjects} />
</Section>
