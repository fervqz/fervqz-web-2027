---
import BaseHead from "../components/BaseHead.astro";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  image?: ImageMetadata;
  type?: "website" | "article";
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  bodyClass = "min-h-screen",
  image,
  type,
  robots,
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      robots={robots}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
