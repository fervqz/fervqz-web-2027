---
import BaseHead from "../components/BaseHead.astro";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
}

const { title, description, bodyClass = "min-h-screen" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
