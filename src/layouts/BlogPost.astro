---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import DotsBackground from "../components/DotsBackground.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import AppLayout from "./AppLayout.astro";
import BackLink from "../components/ui/BackLink.astro";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import Section from "../components/ui/Section.astro";
import Text from "../components/ui/Text.astro";
import Typography from "../components/ui/Typography.astro";
import WavyDivider from "../components/ui/WavyDivider.astro";
import FallbackImage from "../components/ui/FallbackImage.astro";
import { Icon } from "astro-icon/components";

type Props = CollectionEntry<"blog">["data"] & {
  slug: string;
  readingTimeMinutes: number;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  slug,
  readingTimeMinutes,
} = Astro.props;
---

<AppLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  bodyClass="min-h-screen px-4"
>
  <DotsBackground />
  <Header />
  <main class="pb-20 pt-12">
    <Container>
      <article class="mx-auto flex w-full max-w-190 flex-col gap-8">
        <BackLink href="/blog" ariaLabel="Back to blog" />

        <div class="mx-auto w-full">
          {
            heroImage ? (
              <Image
                width={1040}
                height={700}
                src={heroImage}
                alt={title}
                class="h-auto w-full object-cover"
                style={`view-transition-name: blog-image-${slug};`}
              />
            ) : (
              <FallbackImage
                alt={title}
                width={1040}
                height={700}
                class="h-auto w-full object-cover"
                style={`view-transition-name: blog-image-${slug};`}
              />
            )
          }
        </div>

        <header class="space-y-2">
          <Heading as="h1" variant="hero" class="mb-0 max-w-3xl"
            >{title}</Heading
          >
          <!-- <Text class="mb-0 max-w-3xl text-[14px] leading-5">
            {description}
          </Text> -->
          <Text as="div" tone="muted" class="text-[12px] leading-5">
            <Icon
              name="lucide:calendar"
              size={14}
              class="inline-block mb-0.5"
            />{" "}
            <FormattedDate date={pubDate} /> ·
            <span>{readingTimeMinutes} min read</span>
            {
              updatedDate && (
                <div class="italic">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </Text>
        </header>

        <WavyDivider />

        <Section variant="content">
          <Typography>
            <slot />
          </Typography>
        </Section>
      </article>
    </Container>
  </main>
  <Footer />
</AppLayout>

<script>
  const refreshInterval = 500; // 1 second
  const SEPARATOR = "    ";
  const fullString = document.title + SEPARATOR;
  let offset = 0;

  setInterval(() => {
    offset = (offset + 1) % fullString.length;
    document.title = fullString.slice(offset) + fullString.slice(0, offset);
  }, refreshInterval);
</script>
