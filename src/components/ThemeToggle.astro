---
import IconButton from "./ui/IconButton.astro";

interface Props {
  class?: string;
  showLabel?: boolean;
}

const { class: className = "", showLabel = false } = Astro.props;
---

<IconButton
  data-theme-toggle
  as="button"
  type="button"
  icon="lucide:moon"
  secondaryIcon="lucide:sun"
  primaryIconKey="moon"
  secondaryIconKey="sun"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  {showLabel && <span>Toggle theme</span>}
</IconButton>
