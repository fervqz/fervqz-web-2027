---
import { Icon } from "astro-icon/components";
---

<button
  data-theme-toggle
  class="hidden items-center justify-center p-0 text-lg leading-none text-(--nav-link-color) hover:cursor-pointer hover:text-(--nav-link-hover-color) md:inline-flex hover:scale-110 hover:-rotate-10 transition"
  type="button"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <span data-theme-toggle-icon="moon" aria-hidden="true">
    <Icon name="lucide:moon" class="size-4" />
  </span>
  <span data-theme-toggle-icon="sun" aria-hidden="true" hidden>
    <Icon name="lucide:sun" class="size-4" />
  </span>
</button>
