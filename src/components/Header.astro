---
import Container from "./ui/Container.astro";
import HeaderLink from "./HeaderLink.astro";
---

<header class="m-0 p-4">
  <Container>
    <nav class="flex items-center justify-between gap-4">
      <div class="flex flex-row gap-2 items-center">
        <img
          src="/public/img/logo.svg"
          alt="logo"
          width="50"
          class="cursor-pointer drop-shadow-sm hover:scale-105 hover:-rotate-12 transition-transform ease-out hover:drop-shadow-md"
        />
        <span class="text-2xl font-black font-[JetBrains Mono]">Fervqz</span>
      </div>

      <div class="internal-links flex items-center gap-1">
        <HeaderLink href="/">About</HeaderLink>
        <HeaderLink href="/projects">Projects</HeaderLink>
        <HeaderLink href="/blog">Blog</HeaderLink>
        <HeaderLink href="/contact">Contact</HeaderLink>
        <button
          id="theme-toggle"
          class="ml-2 inline-flex h-9 w-9 items-center justify-center rounded-full border border-(--button-border) bg-(--surface-color) p-0 text-lg leading-none text-(--nav-link-color) hover:text-(--nav-link-hover-color) hover:cursor-pointer"
          type="button"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <span id="theme-toggle-icon" aria-hidden="true">🌙</span>
        </button>
      </div>
    </nav>
  </Container>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.getElementById("theme-toggle");
    const icon = document.getElementById("theme-toggle-icon");

    if (!button || !icon) return;

    const getTheme = () => root.getAttribute("data-theme") || "light";
    const setIcon = (theme) => {
      icon.textContent = theme === "dark" ? "☀️" : "🌙";
      button.setAttribute(
        "aria-label",
        theme === "dark" ? "Switch to light mode" : "Switch to dark mode",
      );
      button.setAttribute(
        "title",
        theme === "dark" ? "Switch to light mode" : "Switch to dark mode",
      );
    };

    setIcon(getTheme());

    button.addEventListener("click", () => {
      const nextTheme = getTheme() === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", nextTheme);
      root.style.colorScheme = nextTheme;
      localStorage.setItem("theme", nextTheme);
      setIcon(nextTheme);
    });
  })();
</script>
