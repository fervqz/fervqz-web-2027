---
import Container from "./ui/Container.astro";
import HeaderLink from "./HeaderLink.astro";
import Sticker from "./sticker/Sticker.astro";
import logo from "../assets/img/logo.svg";
import ResetStickers from "./sticker/ResetStickers.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { HEADER_NAV_LINKS } from "./header/navigation";
import { Icon } from "astro-icon/components";
import EditStickers from "./sticker/EditStickers.astro";
---

<header
  class="fixed inset-x-0 top-0 z-50 m-0 flex flex-row"
  data-site-header
  data-scrolled="false"
>
  <Container class="relative">
    <nav class="flex items-center justify-between gap-4">
      <a href="/" class="site-brand flex items-center gap-2">
        <Sticker src={logo} alt="logo" width={50} draggable={false} />
        <span class="text-2xl font-black font-[JetBrains Mono]">Fervqz</span>
      </a>

      <div class="flex items-center gap-1">
        <div class="hidden md:flex md:items-center">
          <ResetStickers />
          <EditStickers />
          <ThemeToggle />
        </div>
        <div class="internal-links hidden items-center gap-1 md:flex">
          {
            HEADER_NAV_LINKS.map((link) => (
              <HeaderLink href={link.href}>{link.label}</HeaderLink>
            ))
          }
        </div>

        <button
          id="mobile-menu-toggle"
          class="mobile-menu-toggle inline-flex h-9 w-9 items-center justify-center text-(--nav-link-color) md:hidden"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span
            id="mobile-menu-icon"
            class="mobile-menu-icon"
            aria-hidden="true"
          >
            <span data-mobile-menu-icon="closed" class="mobile-menu-glyph">
              <Icon name="lucide:menu" class="size-6" />
            </span>
            <span data-mobile-menu-icon="open" class="mobile-menu-glyph">
              <Icon name="lucide:x" class="size-6" />
            </span>
          </span>
        </button>
      </div>
    </nav>

    <div
      id="mobile-menu"
      class="absolute inset-x-0 top-full z-50 mt-2 overflow-hidden border border-(--button-border) bg-white p-3 shadow-lg transition-all duration-250 ease-out md:hidden"
      data-open="false"
    >
      <div class="flex flex-col">
        {
          HEADER_NAV_LINKS.map((link) => (
            <HeaderLink href={link.href} class="py-2!" data-mobile-menu-close>
              {link.label}
            </HeaderLink>
          ))
        }
      </div>
      <div class="mt-2 pt-3">
        <ThemeToggle showLabel class="md:hidden" />
      </div>
    </div>
  </Container>
</header>

<div aria-hidden="true" class="h-18"></div>

<script>
  import { initHeaderInteractions } from "./header/header.client";

  const scheduleInit = () => initHeaderInteractions();
  const idleCallback = globalThis.requestIdleCallback;

  if (typeof idleCallback === "function") {
    idleCallback(scheduleInit, { timeout: 700 });
  } else {
    globalThis.setTimeout(scheduleInit, 0);
  }
</script>

<style>
  [data-site-header] {
    padding-block: 0.5rem;
    border-bottom: 1px solid transparent;
    background-color: transparent;
    transition:
      padding-block 220ms ease,
      background-color 220ms ease,
      backdrop-filter 220ms ease,
      -webkit-backdrop-filter 220ms ease,
      border-color 220ms ease;
  }

  [data-site-header][data-scrolled="true"] {
    padding-block: 0.05rem;
    border-color: var(--surface-border);
    background-color: color-mix(
      in oklab,
      var(--surface-color) 78%,
      transparent
    );
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .site-brand {
    transform: scale(1);
    transform-origin: left center;
    transition: transform 220ms ease;
  }

  .site-brand:hover {
    transform: scale(1.05);
  }

  [data-site-header][data-scrolled="true"] .site-brand {
    transform: scale(0.9);
  }

  [data-site-header][data-scrolled="true"] .site-brand:hover {
    transform: scale(0.95);
  }

  .mobile-menu-toggle {
    transform: rotate(0deg);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-menu-toggle[aria-expanded="true"] {
    transform: rotate(-90deg);
  }

  .mobile-menu-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
  }

  .mobile-menu-glyph {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 240ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-menu-glyph[data-mobile-menu-icon="closed"] {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .mobile-menu-glyph[data-mobile-menu-icon="open"] {
    opacity: 0;
    transform: rotate(90deg) scale(0.7);
  }

  .mobile-menu-toggle[aria-expanded="true"]
    .mobile-menu-glyph[data-mobile-menu-icon="closed"] {
    opacity: 0;
    transform: rotate(-90deg) scale(0.7);
  }

  .mobile-menu-toggle[aria-expanded="true"]
    .mobile-menu-glyph[data-mobile-menu-icon="open"] {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  #mobile-menu {
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    visibility: hidden;
    max-height: 0;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      max-height 260ms ease,
      visibility 220ms ease;
  }

  #mobile-menu[data-open="true"] {
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
    max-height: 28rem;
    pointer-events: auto;
  }
</style>
