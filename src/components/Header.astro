---
import Container from "./ui/Container.astro";
import GlassCard from "./ui/GlassCard.astro";
import HeaderLink from "./HeaderLink.astro";
import Sticker from "./sticker/Sticker.astro";
import logo from "../assets/img/logo.svg";
import ResetStickers from "./sticker/ResetStickers.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { HEADER_NAV_LINKS } from "./header/navigation";
import { Icon } from "astro-icon/components";
import EditStickers from "./sticker/EditStickers.astro";

const isHomePage = Astro.url.pathname === "/";
---

<header
  class="fixed inset-x-0 top-0 z-50 m-0 flex flex-row px-2 pt-3 md:px-0"
  data-site-header
  data-scrolled="false"
>
  <Container class="relative">
    <nav
      class="header-bar flex w-full items-center justify-between gap-4 rounded-none border border-transparent bg-transparent px-3 py-3 shadow-none md:px-5 [transition-property:padding,border-color,border-radius,background-color,box-shadow,backdrop-filter,-webkit-backdrop-filter,transform] duration-220 ease"
    >
      <a
        href="/"
        class="site-brand flex items-center gap-2 origin-left transition-transform duration-220 ease scale-100 hover:scale-105"
        data-astro-prefetch="hover"
      >
        <Sticker src={logo} alt="logo" width={40} draggable={false} />
        <span class="site-brand-text text-[1.40rem] font-black">Fervqz</span>
      </a>

      <div class="flex items-center gap-1">
        <div class="hidden md:flex md:items-center">
          {
            isHomePage && (
              <>
                <ResetStickers />
                <EditStickers />
              </>
            )
          }
          <ThemeToggle />
        </div>
        <div class="internal-links hidden items-center gap-1 md:flex">
          {
            HEADER_NAV_LINKS.map((link) => (
              <HeaderLink
                href={link.href}
                data-contact-link={
                  link.href === "/contact" ? "true" : undefined
                }
              >
                {link.label}
              </HeaderLink>
            ))
          }
        </div>

        <ThemeToggle class="p-5 md:hidden" />

        <button
          id="mobile-menu-toggle"
          class="mobile-menu-toggle inline-flex h-9 w-9 items-center justify-center text-(--nav-link-color) md:hidden rotate-0 transition-[transform] duration-320 ease-[cubic-bezier(0.22,1,0.36,1)]"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span
            id="mobile-menu-icon"
            class="relative inline-flex h-6 w-6 items-center justify-center"
            aria-hidden="true"
          >
            <span
              data-mobile-menu-icon="closed"
              class="absolute inset-0 inline-flex items-center justify-center [transition:opacity_240ms_ease,transform_280ms_cubic-bezier(0.22,1,0.36,1)]"
            >
              <Icon name="lucide:menu" class="size-6" />
            </span>
            <span
              data-mobile-menu-icon="open"
              class="absolute inset-0 inline-flex items-center justify-center [transition:opacity_240ms_ease,transform_280ms_cubic-bezier(0.22,1,0.36,1)]"
            >
              <Icon name="lucide:x" class="size-6" />
            </span>
          </span>
        </button>
      </div>
    </nav>

    <GlassCard
      id="mobile-menu"
      class="absolute inset-x-0 top-full z-50 mt-2 overflow-hidden rounded-3xl p-3 transition-all duration-250 ease-out md:hidden"
      data-open="false"
    >
      <div class="flex flex-col">
        {
          HEADER_NAV_LINKS.map((link) => (
            <HeaderLink href={link.href} class="py-2!" data-mobile-menu-close>
              {link.label}
            </HeaderLink>
          ))
        }
      </div>
    </GlassCard>
  </Container>
</header>

<div aria-hidden="true" class="h-18"></div>

<script>
  import { initHeaderInteractions } from "./header/header.client";

  const scheduleInit = () => initHeaderInteractions();
  const idleCallback = globalThis.requestIdleCallback;

  if (typeof idleCallback === "function") {
    idleCallback(scheduleInit, { timeout: 700 });
  } else {
    globalThis.setTimeout(scheduleInit, 0);
  }
</script>

<style>
  .site-brand-text {
    font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace,
      "SFMono-Regular", Menlo, Monaco, Consolas, "Liberation Mono",
      "Courier New", monospace;
  }

  [data-site-header] {
    transition:
      border-color 220ms ease,
      background-color 220ms ease,
      box-shadow 220ms ease,
      backdrop-filter 220ms ease,
      -webkit-backdrop-filter 220ms ease;
  }

  [data-contact-link="true"] {
    border: 1px solid transparent;
    border-radius: 9999px;
    transition:
      padding 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease,
      box-shadow 220ms ease,
      color 220ms ease;
  }

  [data-site-header][data-scrolled="true"] .header-bar {
    border-color: var(--surface-border);
    border-radius: 10rem;
    background-color: color-mix(
      in oklab,
      var(--surface-color) 78%,
      transparent
    );
    box-shadow: 0 18px 40px
      color-mix(in oklab, var(--surface-color) 40%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  [data-site-header][data-scrolled="true"] [data-contact-link="true"] {
    padding: 0.6rem 1rem;
    border-color: color-mix(in oklab, var(--nav-link-color) 16%, transparent);
    background-color: black;
    color: white;
    box-shadow: 0 10px 24px
      color-mix(in oklab, var(--surface-color) 28%, transparent);
  }

  [data-site-header][data-scrolled="true"] [data-contact-link="true"]:hover {
    background: rgb(34, 34, 34);
  }

  .mobile-menu-toggle[aria-expanded="true"] {
    transform: rotate(-90deg);
  }

  [data-mobile-menu-icon="closed"] {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  [data-mobile-menu-icon="open"] {
    opacity: 0;
    transform: rotate(90deg) scale(0.7);
  }

  .mobile-menu-toggle[aria-expanded="true"] [data-mobile-menu-icon="closed"] {
    opacity: 0;
    transform: rotate(-90deg) scale(0.7);
  }

  .mobile-menu-toggle[aria-expanded="true"] [data-mobile-menu-icon="open"] {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  #mobile-menu {
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    visibility: hidden;
    max-height: 0;
    pointer-events: none;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      max-height 260ms ease,
      visibility 220ms ease;
  }

  #mobile-menu[data-open="true"] {
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
    max-height: 28rem;
    pointer-events: auto;
  }
</style>
