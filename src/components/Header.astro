---
import Container from "./ui/Container.astro";
import HeaderLink from "./HeaderLink.astro";
import Sticker from "./sticker/Sticker.astro";
import logo from "../assets/img/logo.svg";
import ResetStickers from "./sticker/ResetStickers.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { HEADER_NAV_LINKS } from "./header/navigation";
---

<header class="m-0 py-2 flex flex-row">
  <Container class="relative">
    <nav class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <Sticker src={logo} alt="logo" width={50} />
        <a href="/" class="hover:scale-105 transition-transform duration-200">
          <span class="text-2xl font-black font-[JetBrains Mono]">Fervqz</span>
        </a>
      </div>

      <div class="flex items-center gap-1">
        <div class="internal-links hidden items-center gap-1 md:flex">
          {
            HEADER_NAV_LINKS.map((link) => (
              <HeaderLink href={link.href}>{link.label}</HeaderLink>
            ))
          }
        </div>

        <button
          id="mobile-menu-toggle"
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-(--button-border) bg-(--surface-color) text-(--nav-link-color) md:hidden"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span id="mobile-menu-icon" aria-hidden="true">☰</span>
        </button>
      </div>
    </nav>

    <div
      id="mobile-menu"
      class="absolute inset-x-0 top-full z-50 mt-2 rounded-xl border border-(--button-border) bg-(--surface-color) p-3 shadow-lg transition-all duration-200 ease-out md:hidden"
      data-open="false"
    >
      <div class="flex flex-col">
        {
          HEADER_NAV_LINKS.map((link) => (
            <HeaderLink href={link.href} class="py-2!" data-mobile-menu-close>
              {link.label}
            </HeaderLink>
          ))
        }
      </div>
      <div class="mt-2 pt-3">
        <ThemeToggle showLabel class="md:hidden" />
      </div>
    </div>
  </Container>
  <div class="absolute py-4 right-4 flex flex-row items-center">
    <ResetStickers />
    <ThemeToggle class="hidden md:inline-flex" />
  </div>
</header>

<script>
  import { initHeaderInteractions } from "./header/header.client";

  initHeaderInteractions();
</script>

<style>
  #mobile-menu {
    display: none;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
  }

  #mobile-menu[data-open="true"] {
    display: block;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>
