---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { Project } from "../../lib/projects";
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const actionButtonClass =
  "inline-flex w-full items-center justify-center border border-(--button-border) bg-(--button-bg) px-3 py-2 text-xs font-semibold text-(--button-text) no-underline transition-colors group-hover:bg-(--button-hover-bg) group-hover:text-(--button-hover-text)";
---

<div>
  <div
    class="project-carousel-bleed project-carousel-shell relative left-1/2 w-screen -translate-x-1/2"
    data-project-carousel-shell
    style="--carousel-inline-start: max(1rem, calc((100vw - 56rem) / 2 + 1rem));"
  >
    <button
      type="button"
      class="project-carousel-arrow project-carousel-arrow-left"
      data-project-carousel-prev
      aria-label="Scroll projects left"
      hidden
    >
      <Icon name="lucide:chevron-left" size={18} />
    </button>

    <div
      class="project-carousel overflow-x-auto snap-x snap-mandatory"
      data-project-carousel
    >
      <div class="project-carousel-track flex w-max gap-4 pb-4">
        {
          projects.map((project) => (
            <Card
              data-project-card
              class="group relative cursor-pointer flex w-[85vw] max-w-96 shrink-0 snap-start flex-col space-y-4 overflow-hidden backdrop-blur sm:w-96"
            >
              <div class="relative -mx-5 -mt-5 mb-2 overflow-hidden border-b border-(--surface-border) bg-slate-100/70 dark:bg-slate-900/60">
                <Image
                  src={project.image}
                  alt={project.imageAlt}
                  width={1200}
                  sizes="(max-width: 640px) 85vw, (max-width: 1024px) 60vw, 384px"
                  loading="lazy"
                  decoding="async"
                  class="h-66 w-full object-cover object-center transition-transform duration-300 group-hover:scale-120"
                />
                <div class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-linear-to-t from-slate-950/25 to-transparent" />
              </div>

              <Heading as="h3" class="py-2">
                <a
                  href={`/projects/${project.slug}`}
                  class="underline-offset-4 hover:underline after:absolute after:inset-0 after:content-[''] after:z-0"
                >
                  {project.name}
                </a>
              </Heading>

              <Text class="px-1">{project.summary}</Text>

              <ul class="flex flex-wrap gap-2 text-xs">
                {project.stack.map((item) => (
                  <Badge as="li">{item}</Badge>
                ))}
              </ul>

              <div class="relative z-10 mt-auto px-1 pt-2 pointer-events-none">
                <div class={actionButtonClass}>
                  Explore{" "}
                  <Icon name="lucide:arrow-right" class="ml-1" size={16} />
                </div>
              </div>
            </Card>
          ))
        }
      </div>
    </div>

    <button
      type="button"
      class="project-carousel-arrow project-carousel-arrow-right"
      data-project-carousel-next
      aria-label="Scroll projects right"
      hidden
    >
      <Icon name="lucide:chevron-right" size={18} />
    </button>
  </div>
</div>

<script>
  const SCROLL_THRESHOLD = 2;

  const getScrollStep = (scroller: HTMLElement) => {
    const card = scroller.querySelector<HTMLElement>("[data-project-card]");
    if (card) return card.getBoundingClientRect().width + 16;
    return Math.max(scroller.clientWidth * 0.85, 240);
  };

  document
    .querySelectorAll<HTMLElement>("[data-project-carousel-shell]")
    .forEach((shell) => {
      if (shell.dataset.carouselArrowsInitialized === "true") return;
      shell.dataset.carouselArrowsInitialized = "true";

      const scroller = shell.querySelector<HTMLElement>(
        "[data-project-carousel]",
      );
      const prevButton = shell.querySelector<HTMLButtonElement>(
        "[data-project-carousel-prev]",
      );
      const nextButton = shell.querySelector<HTMLButtonElement>(
        "[data-project-carousel-next]",
      );

      if (!scroller || !prevButton || !nextButton) return;

      const updateButtonState = () => {
        const maxScrollLeft = scroller.scrollWidth - scroller.clientWidth;
        const isScrollable = maxScrollLeft > SCROLL_THRESHOLD;

        prevButton.hidden = !isScrollable;
        nextButton.hidden = !isScrollable;

        if (!isScrollable) {
          prevButton.disabled = true;
          nextButton.disabled = true;
          return;
        }

        const atStart = scroller.scrollLeft <= SCROLL_THRESHOLD;
        const atEnd = scroller.scrollLeft >= maxScrollLeft - SCROLL_THRESHOLD;

        prevButton.disabled = atStart;
        nextButton.disabled = atEnd;
      };

      prevButton.addEventListener("click", () => {
        scroller.scrollBy({
          left: -getScrollStep(scroller),
          behavior: "smooth",
        });
      });

      nextButton.addEventListener("click", () => {
        scroller.scrollBy({
          left: getScrollStep(scroller),
          behavior: "smooth",
        });
      });

      scroller.addEventListener("scroll", updateButtonState, { passive: true });
      globalThis.addEventListener("resize", updateButtonState);

      updateButtonState();
    });
</script>

<style>
  .project-carousel-shell {
    --carousel-arrow-offset: 1.35rem;
  }

  .project-carousel {
    -ms-overflow-style: none;
    scrollbar-width: none;
    scroll-padding-left: var(--carousel-inline-start, 1rem);
  }

  .project-carousel::-webkit-scrollbar {
    display: none;
  }

  .project-carousel-track {
    padding-left: var(--carousel-inline-start, 1rem);
    padding-right: 1rem;
  }

  .project-carousel-arrow {
    position: absolute;
    top: 50%;
    z-index: 20;
    display: inline-flex;
    height: 3rem;
    width: 3rem;
    cursor: pointer;
    transform: translateY(-50%);
    align-items: center;
    justify-content: center;
    border: 1px solid var(--surface-border);
    background: var(--surface-color);
    color: var(--text-color);
    backdrop-filter: blur(8px);
    transition:
      opacity 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .project-carousel-arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .project-carousel-arrow:not(:disabled):hover {
    border-color: var(--button-border);
    background: var(--button-hover-bg);
    color: var(--button-hover-text);
  }

  .project-carousel-arrow-left {
    left: max(
      0.25rem,
      calc(var(--carousel-inline-start, 1rem) - var(--carousel-arrow-offset))
    );
  }

  .project-carousel-arrow-right {
    right: max(
      0.25rem,
      calc(var(--carousel-inline-start, 1rem) - var(--carousel-arrow-offset))
    );
  }

  @media (min-width: 640px) {
    .project-carousel-track {
      padding-right: 1.5rem;
    }
  }
</style>
