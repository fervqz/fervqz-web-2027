---
import Text from "../ui/Text.astro";
import { Icon } from "astro-icon/components";
import type { ProjectPhase } from "../../lib/projects";

interface Props {
  stages: ProjectPhase[] | any;
  class?: string;
}

const { stages, class: className } = Astro.props as Props;

// Ensure stages is an array and validate the structure
const stagesArray = Array.isArray(stages)
  ? stages.filter(
      (s) => s && typeof s === "object" && "name" in s && "status" in s,
    )
  : [];

const currentIndex = stagesArray.findIndex(
  (stage) => stage.status === "current",
);

const allStagesCompleted =
  stagesArray.length > 0 &&
  stagesArray.every((stage) => stage.status === "completed");

const connectorActiveUntil = allStagesCompleted
  ? stagesArray.length - 1
  : currentIndex;
---

<div class:list={["my-10 w-full", className]}>
  {
    stagesArray.length === 0 ? (
      <p class="text-slate-400 text-sm">No stages available</p>
    ) : (
      <div class="project-phase-scroll w-full pb-2">
        <ol
          class="grid w-full items-start"
          style={`grid-template-columns: repeat(${stagesArray.length}, minmax(0, 1fr));`}
          aria-label="Project delivery phases"
        >
          {stagesArray.map((stage, index) => {
            const isCompleted = stage.status === "completed";
            const isCurrent = stage.status === "current";
            const isConnectorActive =
              connectorActiveUntil >= 0 && index < connectorActiveUntil;

            return (
              <li class="relative">
                <div class="flex flex-col items-center gap-3 text-center relative z-20">
                  <span
                    class="inline-flex h-6 w-6 items-center justify-center"
                    aria-current={isCurrent ? "step" : undefined}
                    aria-label={`Step ${index + 1}: ${stage.name}`}
                  >
                    {isCompleted ? (
                      <span class="flex-1 h-full flex justify-center items-center bg-white rounded-full p-1 size-2">
                        <Icon
                          name="lucide:check"
                          class=" text-black"
                          size={24}
                          aria-hidden="true"
                        />
                      </span>
                    ) : isCurrent ? (
                      <span
                        class="relative inline-flex size-3"
                        aria-hidden="true"
                      >
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white/60 opacity-75" />
                        <span class="relative inline-flex size-3 rounded-full bg-white" />
                      </span>
                    ) : (
                      <span
                        class="inline-flex h-2.5 w-2.5 rounded-full bg-slate-600"
                        aria-hidden="true"
                      />
                    )}
                  </span>

                  <Text
                    as="p"
                    class:list={[
                      "px-1 text-xs font-medium tracking-wide",
                      isCompleted || isCurrent
                        ? "text-white"
                        : "text-slate-500",
                    ]}
                  >
                    {stage.name}
                  </Text>
                </div>

                {index < stagesArray.length - 1 && (
                  <span
                    class:list={[
                      "absolute top-3 left-1/2 h-0.5 w-full -translate-y-1/2",
                      isConnectorActive ? "bg-white" : "bg-slate-800",
                    ]}
                    aria-hidden="true"
                  />
                )}
              </li>
            );
          })}
        </ol>
      </div>
    )
  }
</div>

<style>
  .project-phase-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .project-phase-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
