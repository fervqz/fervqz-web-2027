<div
  aria-hidden="true"
  class="dots-bg pointer-events-none absolute inset-0 -z-10"
>
  <div class="dots-layer dots-layer-base"></div>
  <div class="dots-layer dots-layer-glow"></div>
</div>

<script is:inline>
  const background = document.querySelector(".dots-bg");

  if (background instanceof HTMLElement) {
    const finePointer = window.matchMedia("(pointer: fine)").matches;

    if (finePointer) {
      let rafId = 0;
      let lastX = 0;
      let lastY = 0;

      const paint = () => {
        rafId = 0;
        const rect = background.getBoundingClientRect();
        background.style.setProperty("--mouse-x", `${lastX - rect.left}px`);
        background.style.setProperty("--mouse-y", `${lastY - rect.top}px`);
      };

      const onPointerMove = (event) => {
        lastX = event.clientX;
        lastY = event.clientY;
        background.dataset.active = "true";

        if (!rafId) {
          rafId = window.requestAnimationFrame(paint);
        }
      };

      const onPointerLeave = () => {
        background.dataset.active = "false";
      };

      background.addEventListener("pointermove", onPointerMove, {
        passive: true,
      });
      background.addEventListener("pointerleave", onPointerLeave);
    }
  }
</script>

<style>
  .dots-bg {
    --dot-step: 24px;
    --dot-base-size: 1.55px;
    --dot-glow-size: 1.9px;
    --mouse-x: 50%;
    --mouse-y: 50%;
    --glow-radius: var(--dots-glow-radius);
    --glow-falloff: var(--dots-glow-falloff);
    background: var(--bg-color);
    overflow: hidden;
  }

  .dots-layer {
    position: absolute;
    inset: 0;
    background-position: calc(var(--dot-step) / 2) calc(var(--dot-step) / 2);
    background-size: var(--dot-step) var(--dot-step);
  }

  .dots-layer-base {
    background-image: radial-gradient(
      circle,
      var(--dots-color) calc(var(--dot-base-size) / 2),
      transparent calc(var(--dot-base-size) / 2)
    );
  }

  .dots-layer-glow {
    background-image: radial-gradient(
      circle,
      color-mix(in oklab, var(--dots-color) 30%, var(--dots-glow-color) 70%)
        calc(var(--dot-glow-size) / 2),
      transparent calc(var(--dot-glow-size) / 2)
    );
    opacity: 0;
    transition: opacity 180ms ease;
    -webkit-mask-image: radial-gradient(
      circle at var(--mouse-x) var(--mouse-y),
      rgb(0 0 0 / 1) 0,
      rgb(0 0 0 / 0.95) var(--glow-radius),
      rgb(0 0 0 / 0) var(--glow-falloff)
    );
    mask-image: radial-gradient(
      circle at var(--mouse-x) var(--mouse-y),
      rgb(0 0 0 / 1) 0,
      rgb(0 0 0 / 0.95) var(--glow-radius),
      rgb(0 0 0 / 0) var(--glow-falloff)
    );
  }

  .dots-bg[data-active="true"] .dots-layer-glow {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .dots-layer-glow {
      transition: none;
    }
  }
</style>
