---
import { Icon } from "astro-icon/components";
import Container from "./ui/Container.astro";
import MagneticButton from "./ui/MagneticButton.astro";
import SectionHeader from "./ui/SectionHeader.astro";
import Text from "./ui/Text.astro";
---

<Container>
  <section
    class="relative flex flex-col items-center gap-6 overflow-hidden border border-(--surface-border) bg-(--surface-color) px-6 py-14 text-center shadow-(--card-shadow)"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 left-1/2 size-80 -translate-x-1/2 rounded-full bg-(--accent-soft) blur-3xl"
    >
    </div>
    <SectionHeader eyebrow="04 — Contact" title="Let's build something" />
    <Text class="relative max-w-xl">
      Have a product, a design system or a wild idea? I'd like to hear about it.
    </Text>
    <MagneticButton
      href="/contact"
      class="relative px-6 py-3 [--button-bg:var(--accent)] [--button-border:var(--accent)] [--button-text:var(--accent-contrast)] [--button-hover-bg:var(--accent-hover)] [--button-hover-text:var(--accent-contrast)]"
    >
      Get in touch
      <Icon name="lucide:arrow-up-right" class="ml-2 size-4" />
    </MagneticButton>
  </section>
</Container>
