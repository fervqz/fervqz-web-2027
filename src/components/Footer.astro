---
import Container from "./ui/Container.astro";
import IconButton from "./ui/IconButton.astro";
---

<footer>
  <Container class="flex flex-row justify-between items-center py-10">
    <div class="flex items-center">
      <IconButton
        as="a"
        href="https://github.com/fervqz"
        target="_blank"
        rel="noopener noreferrer"
        icon="lucide:github"
        aria-label="GitHub"
        title="GitHub"
      />
      <IconButton
        as="a"
        href="https://www.linkedin.com/in/fervqz"
        target="_blank"
        rel="noopener noreferrer"
        icon="lucide:linkedin"
        aria-label="LinkedIn"
        title="LinkedIn"
      />
    </div>
    <div>
      <p class="text-gray-600">
        Made with ❤️ by <a
          href="https://fervqz.com"
          class="hover:underline hover:text-blue-800 transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          @fervqz
        </a>
      </p>
    </div>
  </Container>
</footer>
