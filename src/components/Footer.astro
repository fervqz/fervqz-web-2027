---
import Container from "./ui/Container.astro";
import IconButton from "./ui/IconButton.astro";
---

<footer>
  <Container
    class="flex flex-col items-center justify-center gap-4 py-10 text-center md:flex-row md:items-center md:justify-between md:text-left"
  >
    <div class="flex items-center">
      <IconButton
        as="a"
        href="https://github.com/fervqz"
        target="_blank"
        rel="noopener noreferrer"
        icon="lucide:github"
        aria-label="GitHub"
        tooltip="View on GitHub"
      />
      <IconButton
        as="a"
        href="https://www.linkedin.com/in/fervqz"
        target="_blank"
        rel="noopener noreferrer"
        icon="lucide:linkedin"
        aria-label="LinkedIn"
        tooltip="View on LinkedIn"
      />
    </div>
    <div class="order-3 md:order-0">
      <p class="text-gray-600 text-sm md:text-base">
        Made with ❤️ by <a
          href="https://fervqz.com"
          class="hover:underline hover:text-blue-800 transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          @fervqz
        </a>
      </p>
    </div>
    <!-- <div class="order-2 md:order-0 flex flex-col text-xs">
      <span class="border p-2 text-sm opacity-40"
        ><Icon name="lucide:languages" class="inline-block ml-1" /> English
        <Icon name="lucide:chevron-down" class="inline-block ml-1" /></span
      >
    </div> -->
  </Container>
</footer>
