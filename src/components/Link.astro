---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { class: className, ...props } = Astro.props;
---

<a
  class:list={[
    "text-[rgb(67_56_202)] underline underline-offset-2 hover:text-[rgb(55_48_163)]",
    className,
  ]}
  {...props}
>
  <slot />
</a>
