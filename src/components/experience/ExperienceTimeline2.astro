---
import type { ExperienceEntry } from "../../lib/experience";
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";

interface Props {
  experience: ExperienceEntry[];
}

const { experience } = Astro.props;
---

<!-- Variant 1: Classic vertical timeline -->
<Container class="py-16">
  <div class="mb-10">
    <Text as="p" tone="muted" class="mb-2 text-sm uppercase tracking-[0.2em]">
      Experience
    </Text>
    <Heading as="h2" variant="section">Where I've Worked</Heading>
  </div>
  <div class="relative">
    <div class="absolute left-3.5 top-0 bottom-0 w-px bg-slate-200"></div>
    <ol class="flex flex-col gap-10">
      {
        experience.map((entry) => (
          <li class="relative pl-12">
            <span class="absolute left-0 top-1.5 flex h-7 w-7 items-center justify-center rounded-full border border-slate-200 bg-(--surface-color)">
              <span class="h-2.5 w-2.5 rounded-full bg-slate-400" />
            </span>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <Heading as="h3" class="mb-0!">
                {entry.role}
              </Heading>
              <Text tone="muted" class="font-medium">
                {entry.company}
              </Text>
            </div>
            <Text tone="soft" class="mt-1 text-sm">
              {entry.period} · {entry.location} ·{" "}
              <span class="capitalize">{entry.type}</span>
            </Text>
            <Text class="mt-3 text-sm">{entry.description}</Text>
            <ul class="mt-3 flex flex-col gap-1.5 pl-4">
              {entry.highlights.map((h) => (
                <li class="relative text-sm text-(--soft-text-color) before:absolute before:-left-4 before:content-['–']">
                  {h}
                </li>
              ))}
            </ul>
            <div class="mt-4 flex flex-wrap gap-2">
              {entry.stack.map((s) => (
                <span class="rounded-full border border-slate-200 bg-slate-100 px-3 py-0.5 text-xs font-medium text-slate-600">
                  {s}
                </span>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Container>
