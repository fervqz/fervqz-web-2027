---
import IconButton from "../ui/IconButton.astro";
---

<IconButton
  id="reset-stickers"
  icon="lucide:rotate-ccw"
  as="button"
  type="button"
  aria-label="Reset stickers"
  title="Reset stickers"
/>

<script>
  import { STICKER_RESET_EVENT } from "./events";

  const button = document.getElementById("reset-stickers");

  if (button && button.dataset.stickerResetInitialized !== "true") {
    button.dataset.stickerResetInitialized = "true";
    button.addEventListener("click", () => {
      globalThis.dispatchEvent(new CustomEvent(STICKER_RESET_EVENT));
    });
  }
</script>
