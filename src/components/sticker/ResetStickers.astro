---
import { Icon } from "astro-icon/components";
---

<button
  id="reset-stickers"
  title="Reset stickers"
  class="inline-flex items-center justify-center rounded-full p-2 text-zinc-500 transition hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800"
>
  <Icon name="lucide:rotate-ccw" class="size-4" />
</button>

<script>
  import { STICKER_RESET_EVENT } from "./events";

  const button = document.getElementById("reset-stickers");

  if (button && button.dataset.stickerResetInitialized !== "true") {
    button.dataset.stickerResetInitialized = "true";
    button.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent(STICKER_RESET_EVENT));
    });
  }
</script>
