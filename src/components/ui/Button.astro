---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button">;

const { type = "button", class: className, ...props } = Astro.props;
---

<button
  type={type}
  class:list={[
    "inline-flex items-center justify-center border border-(--button-border) bg-(--button-bg) px-4 py-2 text-sm font-semibold text-(--button-text) transition-colors hover:bg-(--button-hover-bg) hover:text-(--button-hover-text)",
    className,
  ]}
  {...props}
>
  <slot />
</button>
