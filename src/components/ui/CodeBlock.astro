---
import { Code } from "astro:components";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  code?: string;
  lang?: string;
  theme?: string;
}

const {
  code,
  lang = "ts",
  theme = "dark-plus",
  class: className,
  ...props
} = Astro.props;

const renderedCode =
  code ??
  (Astro.slots.has("default") ? await Astro.slots.render("default") : "");
---

<div
  class:list={[
    "mb-4 overflow-hidden border border-[var(--code-border)] bg-[var(--code-bg)] text-sm text-[var(--code-text)]",
    className,
  ]}
  {...props}
>
  <Code code={renderedCode} lang={lang as any} theme={theme as any} />
</div>

<style>
  div :global(pre) {
    background: transparent !important;
    border: 0;
    margin: 0;
    overflow-x: auto;
    padding: 1rem;
  }

  div :global(pre code) {
    background: transparent;
    border-radius: 0;
    padding: 0;
  }
</style>
