---
import type { HTMLAttributes } from "astro/types";

type TextTag =
  | "p"
  | "span"
  | "small"
  | "div"
  | "li"
  | "ul"
  | "ol"
  | "td"
  | "th";

type TextTone = "default" | "muted" | "soft";

interface Props extends HTMLAttributes<"p"> {
  as?: TextTag;
  tone?: TextTone;
}

const { as = "p", tone = "default", class: className, ...props } = Astro.props;

const toneClasses: Record<TextTone, string> = {
  default: "text-(--text-default-color)",
  muted: "text-(--muted-text-color)",
  soft: "text-(--soft-text-color)",
};

const Tag = as;
---

<Tag
  data-tone={tone}
  class:list={["ui-text", toneClasses[tone], className]}
  {...props}
>
  <slot />
</Tag>
