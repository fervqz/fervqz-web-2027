---
import type { HTMLAttributes } from "astro/types";

type TextTag =
  | "p"
  | "span"
  | "small"
  | "div"
  | "li"
  | "ul"
  | "ol"
  | "td"
  | "th";

type TextTone = "default" | "muted" | "soft";

interface Props extends HTMLAttributes<"p"> {
  as?: TextTag;
  tone?: TextTone;
}

const { as = "p", tone = "default", class: className, ...props } = Astro.props;

const toneClasses: Record<TextTone, string> = {
  default: "text-slate-700",
  muted: "text-slate-500",
  soft: "text-slate-600",
};

const Tag = as;
---

<Tag
  data-tone={tone}
  class:list={["ui-text", toneClasses[tone], className]}
  {...props}
>
  <slot />
</Tag>

<style>
  :global(html[data-theme="dark"]) .ui-text[data-tone="default"] {
    color: rgb(241 245 249);
  }

  :global(html[data-theme="dark"]) .ui-text[data-tone="muted"] {
    color: rgb(203 213 225);
  }

  :global(html[data-theme="dark"]) .ui-text[data-tone="soft"] {
    color: rgb(226 232 240);
  }
</style>
