---
import Heading from "./Heading.astro";

interface Props {
  title: string;
  align?: "center" | "left";
}

const { title, align = "center" } = Astro.props;
---

<div class:list={[align === "center" ? "text-center" : ""]}>
  <Heading
    as="h2"
    variant="section"
    class="text-[2rem] md:text-[2.5rem] leading-tight"
  >
    {title}
  </Heading>
</div>
