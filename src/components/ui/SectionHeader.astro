---
import Heading from "./Heading.astro";

interface Props {
  eyebrow: string;
  title: string;
  align?: "center" | "left";
}

const { eyebrow, title, align = "center" } = Astro.props;
---

<div class:list={["space-y-3", align === "center" ? "text-center" : ""]}>
  <p
    class="text-xs font-semibold uppercase tracking-[0.25em] text-(--accent-text)"
  >
    {eyebrow}
  </p>
  <Heading
    as="h2"
    variant="section"
    class="text-[2rem] md:text-[2.5rem] leading-tight"
  >
    {title}
  </Heading>
</div>
