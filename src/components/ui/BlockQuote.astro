---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"blockquote">;

const { class: className, ...props } = Astro.props;
---

<blockquote
  class:list={[
    "mb-4 border-l-4 border-[var(--blockquote-border)] pl-4 italic text-[var(--blockquote-text)]",
    className,
  ]}
  {...props}
>
  <slot />
</blockquote>
