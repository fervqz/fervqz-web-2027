---
import { Icon } from "astro-icon/components";
import Link from "./Link.astro";

interface Props {
  href: string;
  ariaLabel?: string;
}

const { href, ariaLabel = "Go back" } = Astro.props;
---

<div>
  <Link
    href={href}
    class="project-carousel-arrow group inline-flex size-14 cursor-pointer items-center justify-center border border-(--button-border) no-underline backdrop-blur transition-colors duration-180 hover:bg-(--button-hover-bg)"
    aria-label={ariaLabel}
  >
    <Icon
      name="lucide:chevron-left"
      size={20}
      class="text-(--text-color) transition-colors duration-180 group-hover:text-(--button-hover-text)"
    />
  </Link>
</div>
