---
import type { HTMLAttributes } from "astro/types";

type GlassCardTag = "article" | "aside" | "div" | "section";

interface Props extends HTMLAttributes<"div"> {
  as?: GlassCardTag;
}

const { as = "div", class: className, ...props } = Astro.props;

const Tag = as;
---

<Tag
  class:list={[
    "border border-(--surface-border) bg-(--surface-color)/78 shadow-[0_18px_40px_color-mix(in_oklab,var(--surface-color)_40%,transparent)] [backdrop-filter:blur(14px)] [-webkit-backdrop-filter:blur(14px)]",
    "rounded-[1.75rem] p-5 md:p-6",
    className,
  ]}
  {...props}
>
  <slot />
</Tag>
