---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div">;

const { class: className, ...props } = Astro.props;
---

<div class:list={["typography", className]} {...props}>
  <slot />
</div>

<style>
  .typography :global(h1),
  .typography :global(h2),
  .typography :global(h3),
  .typography :global(h4),
  .typography :global(h5),
  .typography :global(h6) {
    color: var(--text-color);
    font-family: "Zalando Sans Variable", "Zalando Sans", sans-serif;
    font-weight: 700;
  }

  .typography :global(h1) {
    font-size: 2.125rem;
    line-height: 1.2059;
    letter-spacing: 0.4px;
    margin-bottom: 1rem;
  }

  .typography :global(h2) {
    font-size: 1.75rem;
    line-height: 1.2143;
    letter-spacing: 0.38px;
    margin-bottom: 0.75rem;
  }

  .typography :global(h3) {
    font-size: 1.375rem;
    line-height: 1.2727;
    letter-spacing: -0.26px;
    margin-bottom: 0.5rem;
  }

  .typography :global(h4) {
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.45px;
    margin-bottom: 0.25rem;
  }

  .typography :global(h5) {
    font-size: 1.0625rem;
    line-height: 1.2941;
    letter-spacing: -0.43px;
    margin-bottom: 0.25rem;
  }

  .typography :global(h6) {
    font-size: 1rem;
    line-height: 1.3125;
    letter-spacing: -0.31px;
    margin-bottom: 0.25rem;
  }

  .typography :global(p) {
    color: var(--muted-text-color);
    margin-bottom: 1rem;
  }

  .typography :global(strong) {
    font-weight: 700;
  }

  .typography :global(ul),
  .typography :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .typography :global(li) {
    margin-bottom: 0.25rem;
  }

  .typography :global(:not(pre) > code) {
    background: var(--inline-code-bg);
    border-radius: 0.125rem;
    padding: 0.125rem 0.25rem;
  }

  .typography :global(pre) {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    color: var(--code-text);
    margin: 0 0 1rem;
    overflow-x: auto;
    padding: 1rem;
  }

  .typography :global(pre code) {
    background: transparent;
    border-radius: 0;
    padding: 0;
  }

  .typography :global(pre.astro-code) {
    background: var(--code-bg) !important;
    color: var(--code-text) !important;
  }

  .typography :global(table) {
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
    width: 100%;
  }

  .typography :global(thead) {
    background: color-mix(in oklab, var(--surface-color) 85%, transparent);
  }

  .typography :global(th),
  .typography :global(td) {
    border-bottom: 1px solid var(--surface-border);
    padding: 0.75rem 1rem;
  }

  .typography :global(details) {
    background: var(--details-bg);
    border: 1px solid var(--surface-border);
    margin-bottom: 1rem;
    padding: 1rem;
  }

  .typography :global(summary) {
    cursor: pointer;
    font-weight: 600;
  }

  .typography :global(blockquote) {
    border-left: 4px solid var(--blockquote-border);
    color: var(--blockquote-text);
    margin-bottom: 1rem;
    padding-left: 1rem;
  }
</style>
