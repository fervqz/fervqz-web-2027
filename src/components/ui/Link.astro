---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { class: className, ...props } = Astro.props;
---

<a
  class:list={[
    "text-[var(--link-color)] underline underline-offset-2 hover:text-[var(--link-hover-color)]",
    className,
  ]}
  {...props}
>
  <slot />
</a>
