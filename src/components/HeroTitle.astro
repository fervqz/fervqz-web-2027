---
// HeroTitle.astro - Animated hero title with CSS-only rotating words
---

<h1
  class="hero-title mt-3.5 mb-6 text-center text-6xl md:text-7xl leading-tight font-black tracking-[-0.02em] md:text-left"
>
  <span class="rotating-word-stack w-full" aria-hidden="true">
    <span class="rotating-word">Creative</span>
    <span class="rotating-word">Product</span>
    <span class="rotating-word">Frontend</span>
  </span>
  <span class="sr-only">Creative Product Frontend</span>
  <!-- <br /> -->
  Developer
</h1>

<style>
  .hero-title {
    font-family: "Zalando Sans Variable", "Zalando Sans", "Inter", "Segoe UI",
      Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .rotating-word-stack {
    position: relative;
    display: inline-block;
    height: 1.1em;
    overflow: hidden;
    vertical-align: baseline;
  }

  .rotating-word {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    text-align: center;
    white-space: nowrap;
    will-change: transform, opacity;
    opacity: 0;
    transform: translateY(100%);
    animation: rotate-word 4.95s infinite;
  }

  @media (min-width: 48rem) {
    .rotating-word {
      text-align: left;
    }
  }

  .rotating-word:nth-child(1) {
    animation-delay: 0s;
  }

  .rotating-word:nth-child(2) {
    animation-delay: 1.65s;
  }

  .rotating-word:nth-child(3) {
    animation-delay: 3.3s;
  }

  @keyframes rotate-word {
    0% {
      opacity: 0;
      transform: translateY(100%);
    }

    10% {
      opacity: 1;
      transform: translateY(0);
    }

    31% {
      opacity: 1;
      transform: translateY(0);
    }

    41% {
      opacity: 0;
      transform: translateY(-100%);
    }

    100% {
      opacity: 0;
      transform: translateY(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotating-word {
      animation: none;
      opacity: 0;
      transform: translateY(100%);
    }

    .rotating-word:first-child {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
